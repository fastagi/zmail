{
  "name": "Zmail · Service notification",
  "subject": "{{title}}",
  "html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>{{title}}</title></head>\n<body style=\"margin:0;padding:0;background-color:#f3f5f7;color:#17212b;font-family:Arial,'Microsoft YaHei',sans-serif;\">\n<div style=\"display:none;max-height:0;overflow:hidden;mso-hide:all;\">Your mail workspace, clearly organized.</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:#f3f5f7;\"><tr><td align=\"center\" style=\"padding:32px 16px;\">\n<table role=\"presentation\" width=\"560\" cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%;max-width:560px;\">\n<tr><td style=\"padding:0 0 20px;\"><a href=\"https://zmail.im\" style=\"color:#17212b;font-size:25px;font-weight:700;letter-spacing:-1px;text-decoration:none;\">Zmail<span style=\"color:#2563eb;\">.</span></a></td></tr>\n<tr><td style=\"background-color:#fff;border:1px solid #e1e6ec;border-radius:12px;padding:32px 28px;\">\n<h1 style=\"margin:0 0 24px;font-size:25px;line-height:1.35;font-weight:700;\">{{title}}</h1>\n<p style=\"margin:0 0 16px;font-size:15px;line-height:1.8;\">Hello {{first_name|there}},</p>\n<p style=\"margin:0 0 28px;font-size:15px;line-height:1.8;white-space:pre-line;\">{{message}}</p>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\"><tr><td bgcolor=\"#175cd3\" style=\"border-radius:6px;\"><a href=\"https://zmail.im/console\" style=\"display:inline-block;padding:13px 22px;border:1px solid #175cd3;border-radius:6px;color:#fff;font-size:15px;font-weight:700;text-decoration:none;\">View details</a></td></tr></table>\n<p style=\"margin:28px 0 0;padding-top:24px;border-top:1px solid #edf0f3;color:#526171;font-size:13px;line-height:1.7;\">Need help? Reply to this email. Your reply reaches our team inbox.</p>\n</td></tr>\n<tr><td style=\"padding:20px 4px 0;color:#596777;font-size:12px;line-height:1.8;\">\n<p style=\"margin:0 0 8px;\">You received this email because of an action or service associated with your Zmail workspace.</p>\n<p style=\"margin:0;\">Zmail · <a href=\"https://zmail.im\" style=\"color:#415166;\">zmail.im</a> · <a href=\"mailto:hello@notify.zmail.im\" style=\"color:#415166;\">hello@notify.zmail.im</a></p>\n</td></tr></table></td></tr></table></body></html>\n",
  "text": "{{title}}\n\nHello {{first_name|there}},\n\n{{message}}\n\nView details: https://zmail.im/console\n\nNeed help? Reply to this email. Your reply reaches our team inbox.\n\nYou received this email because of an action or service associated with your Zmail workspace.\n\nZmail | https://zmail.im | hello@notify.zmail.im",
  "sample_variables": {
    "first_name": "Shude",
    "title": "Your Zmail sender is ready",
    "message": "Your sender identity, branded templates, and delivery feedback are configured. This message verifies the new sending experience."
  }
}
