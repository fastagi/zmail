# Server settings for ai_triage.flow.md (sourced by run_local.sh and by the flow's helpers; test values only).
OPTIONAL_STARTERS=organization,mailbox
MAILBOX_DOMAIN=mail.localhost
MAILBOX_INBOUND_SECRET=kest-inbound-secret-at-least-32-chars
# The rule-based model; the API refuses it when APP_ENV is production.
AI_TRIAGE_PROVIDER=fake
AI_TRIAGE_DAILY_CAP=100
