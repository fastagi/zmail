# Available configuration keys and safe local examples. Not every deployment
# must set every key; required combinations are enforced by typed validation.
# Precedence and lifecycle: docs/CONFIGURATION.md

APP_NAME=Zmail
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8025

# Additive optional starters: organization, permission, notification, asset, setting, usage, webhook.
# Permission, setting, usage, and webhook require organization; notification and asset are independent.
OPTIONAL_STARTERS=
# Organization invitation token lifetime; used only when organization is selected.
ORGANIZATION_INVITATION_TTL=168h

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8025
SERVER_MODE=debug
SERVER_READ_TIMEOUT=60
SERVER_READ_HEADER_TIMEOUT=10
# Must exceed MIDDLEWARE_REQUEST_TIMEOUT unless set to 0 intentionally.
SERVER_WRITE_TIMEOUT=190
SERVER_IDLE_TIMEOUT=120
SERVER_MAX_HEADER_BYTES=65536
# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For/X-Real-IP.
# Leave empty when the API is reached directly. Never use 0.0.0.0/0 or ::/0.
SERVER_TRUSTED_PROXIES=
# SERVER_DIAGNOSTICS_ADDR=127.0.0.1:6060 # Off by default; serves pprof on a loopback address only

# CORS Configuration
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization,Organization-Id,Idempotency-Key,If-Match,X-Request-ID
CORS_EXPOSE_HEADERS=Content-Length,ETag,X-Request-ID
CORS_ALLOW_CREDENTIALS=true

# Optional Error Tracking
SENTRY_DSN=

# Database Configuration
DB_ENABLED=true
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=fastbuild
DB_SSLMODE=disable
DB_TIMEZONE=UTC
DB_MAX_OPEN_CONNS=100
# DB_MAX_IDLE_CONNS=100 # Defaults to DB_MAX_OPEN_CONNS; lower it only to release connections sooner
# DB_QUERY_EXEC_MODE=simple_protocol # cache_statement is faster; read docs/DATABASE.md before switching
DB_CONN_MAX_IDLE_TIME=15m
DB_CONN_MAX_LIFETIME=1h
DB_CONNECT_TIMEOUT=5s
DB_LOG_LEVEL=
DB_SLOW_THRESHOLD=1s
DB_LOG_IGNORE_NOT_FOUND=true

# Queue / Workflow
QUEUE_DRIVER=sync
QUEUE_DEFAULT=default
QUEUE_BUFFER_SIZE=256
QUEUE_WORKER_CONCURRENCY=1
QUEUE_WORKER_SLEEP=1s
QUEUE_WORKER_TIMEOUT=60s
QUEUE_LEASE_DURATION=90s
QUEUE_HEARTBEAT_INTERVAL=20s
SCHEDULER_ENABLED=false

# Authentication Session Policy
# User bearer credentials are opaque, stored only by SHA-256 hash, and resolved
# from current persistence on every protected request. No signing secret is used.
AUTH_SESSION_TTL=720h
AUTH_SESSION_IDLE_TIMEOUT=168h
AUTH_SESSION_TOUCH_INTERVAL=5m
AUTH_SESSION_RETENTION=720h
# Public self-registration (POST /v1/register). Set false on an instance whose accounts are created
# out of band; the route then answers 403 AUTH.FORBIDDEN.
AUTH_REGISTRATION_ENABLED=true
# Registration needs a 6-digit code mailed by POST /v1/register/email-codes, so it needs a working
# system mailer (MAIL_*). Set false only where no mail can be sent, such as local development.
AUTH_REGISTRATION_EMAIL_CODE_REQUIRED=true
# Encrypts authenticator-app secrets for two-factor sign-in (at least 32 characters). Empty turns
# new enrollment off; accounts that already use two-factor sign-in still need their code.
AUTH_TOTP_ENCRYPTION_KEY=

# Log Configuration
LOG_LEVEL=debug
LOG_FILE=logs/app.log
LOG_STDOUT=true
LOG_FILE_ENABLED=true
LOG_JSON=false

# Middleware Configuration
MIDDLEWARE_REQUEST_TIMEOUT=180  # Cooperative request timeout in seconds (default: 180 = 3 minutes)
MIDDLEWARE_BODY_LIMIT_MB=10     # Max request body size in MB (default: 10)
# MIDDLEWARE_RATE_LIMIT_ENABLED=true # Optional override; defaults to true in production and false otherwise
MIDDLEWARE_RATE_LIMIT_MAX=600       # Max requests per window per client IP
MIDDLEWARE_RATE_LIMIT_WINDOW=1m     # Rate limit window duration
MIDDLEWARE_RATE_LIMIT_MAX_BUCKETS=10000 # Process-local active client buckets
MIDDLEWARE_RATE_LIMIT_SKIP_PATHS=/health,/health/live,/health/ready,/metrics,/v1/health
# Rate-limit store shared by the global and auth limiters. memory (default) enforces every budget
# per replica, so N replicas allow N times the budget. postgres shares one budget across replicas
# through one UNLOGGED-table upsert per decision (requires DB_ENABLED=true and migrations).
# RATE_LIMIT_STORE_FAILURE decides a decision when PostgreSQL errors or exceeds the timeout:
# local (default) enforces a process-local budget, open allows, closed denies with 429.
RATE_LIMIT_STORE=memory
RATE_LIMIT_STORE_TIMEOUT=50ms      # Per-decision PostgreSQL budget, at most 1s
RATE_LIMIT_STORE_FAILURE=local     # local, open, or closed
# Public auth abuse protection. Defaults to enabled in production and disabled elsewhere.
# Each endpoint has an independent source-IP bucket. Login and reset flows also
# have a normalized, hashed subject bucket to resist distributed attempts. The login
# subject budget counts failures per account; a successful sign-in clears it.
# AUTH_RATE_LIMIT_ENABLED=true # Optional override; defaults to true in production and false otherwise
AUTH_RATE_LIMIT_MAX_BUCKETS_PER_RULE=10000
AUTH_RATE_LIMIT_LOGIN_IP_MAX=20
AUTH_RATE_LIMIT_LOGIN_IP_WINDOW=5m
AUTH_RATE_LIMIT_LOGIN_SUBJECT_MAX=10
AUTH_RATE_LIMIT_LOGIN_SUBJECT_WINDOW=15m
AUTH_RATE_LIMIT_REGISTER_IP_MAX=10
AUTH_RATE_LIMIT_REGISTER_IP_WINDOW=1h
AUTH_RATE_LIMIT_REGISTER_SUBJECT_MAX=0
AUTH_RATE_LIMIT_REGISTER_SUBJECT_WINDOW=0s
AUTH_RATE_LIMIT_PASSWORD_RESET_IP_MAX=10
AUTH_RATE_LIMIT_PASSWORD_RESET_IP_WINDOW=1h
AUTH_RATE_LIMIT_PASSWORD_RESET_SUBJECT_MAX=3
AUTH_RATE_LIMIT_PASSWORD_RESET_SUBJECT_WINDOW=1h
AUTH_RATE_LIMIT_PASSWORD_RESET_CONFIRM_IP_MAX=10
AUTH_RATE_LIMIT_PASSWORD_RESET_CONFIRM_IP_WINDOW=15m
AUTH_RATE_LIMIT_PASSWORD_RESET_CONFIRM_SUBJECT_MAX=5
AUTH_RATE_LIMIT_PASSWORD_RESET_CONFIRM_SUBJECT_WINDOW=15m
AUTH_RATE_LIMIT_REGISTER_EMAIL_CODE_IP_MAX=10
AUTH_RATE_LIMIT_REGISTER_EMAIL_CODE_IP_WINDOW=1h
AUTH_RATE_LIMIT_REGISTER_EMAIL_CODE_SUBJECT_MAX=5
AUTH_RATE_LIMIT_REGISTER_EMAIL_CODE_SUBJECT_WINDOW=1h
# METRICS_ENABLED=true              # Optional override; defaults to false in production and true otherwise

# AI Capability
# Only OpenAI is built in today. Additional providers require an ai.Provider
# adapter, typed configuration validation, and registration in ai.NewManager.
# The streaming seam is already in place — see ai.StreamingProvider.
# Model IDs are provider-owned values. Enabling AI requires an explicit model
# and API key; the scaffold intentionally does not select a fast-moving model.
AI_ENABLED=false
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=
AI_REQUEST_TIMEOUT=120s
AI_MAX_INPUT_BYTES=1048576
AI_MAX_RESPONSE_BYTES=4194304
AI_MAX_STREAM_EVENT_BYTES=1048576
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Email Capability: password resets, invitations, and notifications.
# MAIL_PROVIDER is "resend" (the default) or "cloudflare". Cloudflare sends from MAIL_FROM, which
# must be on a domain enabled for Cloudflare Email Sending, such as "Zmail <noreply@mail.example.com>";
# its credentials default to the MAILBOX_CLOUDFLARE_* values. "log" writes each message, including
# one-time codes, to the API log instead of sending it; it is accepted only when APP_ENV is
# development (`make dev` uses it).
MAIL_PROVIDER=
MAIL_FROM=
RESEND_API_KEY=
MAIL_CLOUDFLARE_ACCOUNT_ID=
MAIL_CLOUDFLARE_API_TOKEN=
MAIL_REQUEST_TIMEOUT=10s

# Optional Mailbox Starter (OPTIONAL_STARTERS=organization,mailbox)
# MAILBOX_DOMAIN is the address domain of every mailbox. Outside production it defaults to
# mail.localhost and MAILBOX_PROVIDER defaults to "log", which records outbound mail in the
# log without delivering it. Production requires an explicit domain and MAILBOX_PROVIDER=cloudflare.
MAILBOX_DOMAIN=
MAILBOX_PROVIDER=
MAILBOX_CLOUDFLARE_ACCOUNT_ID=
MAILBOX_CLOUDFLARE_API_TOKEN=
MAILBOX_REQUEST_TIMEOUT=15s
# Shared secret (32+ characters) that signs deliveries from the Cloudflare Email Worker.
# Leave empty to keep inbound mail disabled.
MAILBOX_INBOUND_SECRET=
# Send lanes, each counted separately per organization over a rolling 24 hours (1 to 100000).
# MAILBOX_DAILY_SEND_LIMIT is the personal lane: console sends, replies, outbound-mail-messages,
# and template tests. The broadcast and transactional lanes take its value when left empty. The
# organization's total can reach the sum of the three, so keep it within the provider account limit.
MAILBOX_DAILY_SEND_LIMIT=200
MAILBOX_DAILY_BROADCAST_LIMIT=
MAILBOX_DAILY_TRANSACTIONAL_LIMIT=
# Caps every lane of organizations younger than MAILBOX_NEW_ORGANIZATION_PERIOD, which slows
# abuse of open registration. 0 turns the cap off.
MAILBOX_NEW_ORGANIZATION_DAILY_SEND_LIMIT=0
MAILBOX_NEW_ORGANIZATION_PERIOD=168h
# Mailboxes one organization may own, between 1 and 5000. Lowering it keeps existing mailboxes;
# only new creates and imports are refused.
MAILBOX_MAX_PER_ORGANIZATION=50
# Public origin of the Web console, such as https://app.example.com. Broadcast unsubscribe links
# point at it; broadcasts also need MAILBOX_INBOUND_SECRET. Leave empty to keep broadcasts off.
MAILBOX_PUBLIC_URL=
# Lets organization owners and admins connect their own domains, into a zone the operator added to
# the Cloudflare account or into a managed zone Zmail creates for the apex. The token then needs
# Account -> Zone: Edit, DNS Edit, Zone Settings Edit, Email Routing Rules Edit, and Email Sending
# Edit, with zone resources set to all zones of the account: a token scoped to named zones cannot
# reach the zones Zmail creates. Any organization may claim a domain in a zone the operator added,
# so keep zones organizations must not use in a separate Cloudflare account.
MAILBOX_CUSTOM_DOMAINS_ENABLED=false
# The Email Worker that routing rules of organization domains deliver to.
MAILBOX_CLOUDFLARE_EMAIL_WORKER=
# How many zones Zmail may add to the Cloudflare account for one organization's own apex
# domains, between 1 and 20. Cloudflare limits how many zones an account adds.
MAILBOX_MAX_ZONES_PER_ORGANIZATION=3
# Transactional mail (POST /v1/transactional-messages). Off by default; turning it on requires
# MAILBOX_SECRET_ENCRYPTION_KEY (32+ characters), which encrypts queued content and keys the
# idempotency fingerprints. Keep it apart from database backups; rotating it fails queued messages.
MAILBOX_TRANSACTIONAL_ENABLED=false
MAILBOX_SECRET_ENCRYPTION_KEY=
# Addresses on this domain (delivered@, bounced@, soft-bounced@, complained@, suppressed@) are
# simulated instead of sent.
MAILBOX_SIMULATOR_DOMAIN=test.zmail.im
# Transactional rate limits: per organization, mode, template, and recipient per minute (1 to
# 1000), and per API key per second (1 to 10000).
MAILBOX_TRANSACTIONAL_RECIPIENT_PER_MINUTE=3
MAILBOX_TRANSACTIONAL_KEY_PER_SECOND=20

# Optional AI triage of inbound mail (mailbox starter). "disabled" keeps the feature hidden and
# calls no model. "fake" classifies with fixed rules for tests and local demos and is refused in
# production. No real provider exists yet, so no provider key is read. AI_TRIAGE_MODEL labels the
# stored results (empty takes the provider name). AI_TRIAGE_DAILY_CAP is the most model calls one
# organization may make per UTC day (1 to 100000); an organization's own cap can only be lower.
AI_TRIAGE_PROVIDER=disabled
# AI_TRIAGE_MODEL=
AI_TRIAGE_DAILY_CAP=500

# Optional read-only external mailboxes (mailbox starter): a comma-separated list of enabled
# connectors: gmail, outlook, imap. Empty keeps binding hidden (its endpoints answer 404) and the
# mail:external:sync worker off. "fake" serves scripted mail from memory for tests and local demos;
# it is refused in production and cannot be combined with a real connector. A non-empty list needs
# MAILBOX_SECRET_ENCRYPTION_KEY, which seals grants.
EXTERNAL_MAIL_PROVIDERS=
# Where a provider sends the browser back after sign-in (the Web console's callback page); each
# provider's OAuth application must list it. Absolute https URL; http is accepted outside
# production.
EXTERNAL_MAIL_REDIRECT_URL=
# The client of the OAuth application each OAuth connector signs in with: the operator's own, or an
# organization's internal application (which needs no provider verification). Required when the
# list above names the provider. The Outlook tenant defaults to "common" (any account).
# EXTERNAL_MAIL_GMAIL_CLIENT_ID=
# EXTERNAL_MAIL_GMAIL_CLIENT_SECRET=
# EXTERNAL_MAIL_OUTLOOK_CLIENT_ID=
# EXTERNAL_MAIL_OUTLOOK_CLIENT_SECRET=
# EXTERNAL_MAIL_OUTLOOK_TENANT=common
# Sync budget of the mail:external:sync worker. Each pass fetches at most this many connections of
# one provider (1-1000), taken round-robin across providers so one provider's outage or backlog
# cannot starve the others. A connection with more pages ready is fetched again at once for up to
# EXTERNAL_MAIL_MAX_IMMEDIATE_PAGES pages in a row (1-1000), then waits the spacing (1s-10m) before
# each further page. One fetch may take at most EXTERNAL_MAIL_FETCH_TIMEOUT (1s-10m); a timeout or
# any other failing fetch backs off from 2 minutes up to 1 hour.
# EXTERNAL_MAIL_PROVIDER_FETCHES_PER_PASS=20
# EXTERNAL_MAIL_MIN_FETCH_SPACING=5s
# EXTERNAL_MAIL_MAX_IMMEDIATE_PAGES=20
# EXTERNAL_MAIL_FETCH_TIMEOUT=60s
# How long the copies of a revoked connection stay before the mail worker deletes them, as a duration
# or a day count (24h-8760h, e.g. 720h or 30d). A value that does not parse stops startup rather than
# falling back to the default. The member may delete them at once; binding the account again before
# the deadline keeps them. Every key in this block refuses a set but invalid value the same way.
# EXTERNAL_MAIL_REVOKED_RETENTION=720h
# How many live shared connections (team accounts an owner or admin binds into a shared connected
# mailbox) one organization may hold, 1-100. They never count against a member's 10 own connections.
# EXTERNAL_MAIL_MAX_SHARED_CONNECTIONS=20
# Tenant connect (off by default): an organization owner authorizes a whole Google Workspace (the
# organization's own service account with domain-wide delegation for gmail.readonly and
# admin.directory.user.readonly) or Microsoft 365 tenant (the organization's own application with the
# application permissions Mail.Read and User.Read.All). Owners and admins then assign mailboxes from
# its directory. Needs the gmail or outlook connector enabled above. While false every tenant route
# answers as an unavailable feature; mailboxes already assigned keep syncing.
# EXTERNAL_MAIL_TENANTS_ENABLED=false
# How many live assignments one tenant may hold, 1-10000. Assignments never count against a member's
# 10 own connections; shared ones count against the shared limit above.
# EXTERNAL_MAIL_MAX_TENANT_ASSIGNMENTS=1000
# Mail agent grants (mailbox starter): how long agent feed events and the agent audit are kept
# (the mail:broadcast:work pass prunes them), and how many agent route requests one API key may
# make per minute.
# MAIL_AGENT_EVENT_RETENTION=720h
# MAIL_AGENT_AUDIT_RETENTION=2160h
# MAIL_AGENT_READS_PER_MINUTE=600

# Optional Object Storage Capability
# "disabled" keeps the capability inert. Selecting the asset starter defaults to
# "local" outside production; production asset deployments must explicitly use "r2".
OBJECT_STORAGE_DRIVER=disabled
OBJECT_STORAGE_LOCAL_ROOT=storage/objects
OBJECT_STORAGE_REQUEST_TIMEOUT=30s

# Asset Starter Policy
# Required only for the local object-storage adapter. Generate with:
# openssl rand -hex 32
ASSET_TRANSFER_SIGNING_KEY=
ASSET_MAX_BYTES=10485760
ASSET_UPLOAD_GRANT_TTL=10m
ASSET_DOWNLOAD_GRANT_TTL=5m
ASSET_PENDING_TTL=1h

# Outbound Webhook Starter
# Required when OPTIONAL_STARTERS includes webhook. Generate a unique deployment key,
# for example with: openssl rand -hex 32
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_REQUEST_TIMEOUT=15s
WEBHOOK_MAX_RESPONSE_BYTES=65536
WEBHOOK_SECRET_OVERLAP=24h
WEBHOOK_EVENT_RETENTION=720h
# Local verification only. Both overrides are rejected in production.
WEBHOOK_ALLOW_INSECURE_HTTP=false
WEBHOOK_ALLOW_PRIVATE_TARGETS=false

# Platform Operator Starter (Admin Console sign-in)
# Required when OPTIONAL_STARTERS includes operator: exact Admin Console origins, comma separated.
OPERATOR_ALLOWED_ORIGINS=http://127.0.0.1:4173
# Optional. Defaults to __Host-fastbuild_operator in production and fastbuild_operator elsewhere.
OPERATOR_SESSION_COOKIE_NAME=

# Private Cloudflare R2 / S3-compatible API credentials
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_ENDPOINT=

# Optional OpenTelemetry Tracing
TRACING_ENABLED=false           # Enable/disable distributed tracing
TRACING_ENDPOINT=localhost:4317 # OTLP gRPC endpoint (Jaeger, Tempo, etc.)
TRACING_INSECURE=true           # Use insecure connection (for development)
TRACING_SAMPLE_RATE=1.0         # Sampling rate (0.0 to 1.0, 1.0 = sample all)

# Audit starter: async queues request audit records and writes them in batches after the response;
# sync writes each record before the response completes.
AUDIT_WRITE_MODE=async
