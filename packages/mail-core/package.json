{
  "name": "@zmail/mail-core",
  "version": "0.1.0",
  "description": "Platform-agnostic mail domain transport, delta sync reducer, and optimistic queue helpers for Zmail.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./transport": {
      "types": "./src/transport.ts",
      "default": "./src/transport.ts"
    },
    "./delta-sync": {
      "types": "./src/delta-sync.ts",
      "default": "./src/delta-sync.ts"
    },
    "./optimistic": {
      "types": "./src/optimistic.ts",
      "default": "./src/optimistic.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.ts"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
