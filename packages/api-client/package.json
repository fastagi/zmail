{
  "name": "@zmail/api-client",
  "version": "0.1.0",
  "description": "Platform-agnostic HTTP client and shared API envelope types for Zmail clients.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./inbox": {
      "types": "./src/inbox.ts",
      "default": "./src/inbox.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.ts"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
